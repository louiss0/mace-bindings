{
  "$schema": "../../.nx/installation/node_modules/nx/schemas/project-schema.json",
  "name": "mace-node",
  "projectType": "library",
  "sourceRoot": "packages/node/src",
  "release": {
    "version": {
      "versionActions": "@nx/js/src/release/version-actions",
      "currentVersionResolver": "disk"
    }
  },
  "targets": {
    "build": {
      "command": "pnpm --dir packages/node run build",
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "check": {
      "command": "pnpm --dir packages/node run check",
      "cache": true
    },
    "test": {
      "command": "pnpm --dir packages/node run test",
      "cache": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "packages/node"
      }
    }
  }
}
