{
  "name": "@code-fixer-23/mace-node",
  "version": "1.0.0",
  "description": "Official Node.js bindings for Mace",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.0.18"
  }
}