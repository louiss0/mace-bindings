{
  "installation": {
    "version": "23.1.1",
    "plugins": {
      "@nx/js": "23.1.1",
      "@nx/vite": "23.1.1",
      "@nx/vitest": "23.1.1"
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "release": {
    "groups": {
      "node": {
        "projects": ["mace-node"],
        "projectsRelationship": "independent",
        "releaseTag": {
          "pattern": "node-v{version}"
        }
      },
      "python": {
        "projects": ["mace-python"],
        "projectsRelationship": "independent",
        "releaseTag": {
          "pattern": "python-v{version}"
        }
      },
      "dart": {
        "projects": ["mace-dart"],
        "projectsRelationship": "independent",
        "releaseTag": {
          "pattern": "dart-v{version}"
        }
      }
    },
    "version": {
      "currentVersionResolver": "disk",
      "git": {
        "commit": true,
        "commitMessage": "chore(release): update bindings",
        "tag": true,
        "push": false
      }
    },
    "changelog": {
      "workspaceChangelog": true,
      "projectChangelogs": false,
      "automaticFromRef": true
    }
  }
}